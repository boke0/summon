#!/usr/bin/env python3

import json
import os
import random
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_ROOT, "lib"))

from generate import DEFAULT_COUNT, items_for_query  # noqa: E402


def _rng():
    seed = os.environ.get("SUMMON_REGEX_SEED")
    if seed is None or seed == "":
        return random.Random()
    try:
        return random.Random(int(seed))
    except ValueError:
        return random.Random(seed)


def _count():
    raw = os.environ.get("SUMMON_REGEX_COUNT")
    if raw is None or raw == "":
        return DEFAULT_COUNT
    try:
        value = int(raw)
    except ValueError:
        return DEFAULT_COUNT
    if value < 1:
        return 1
    return min(value, 32)


def main():
    query = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        items = items_for_query(query, rng=_rng(), count=_count())
    except Exception as exc:
        sys.stderr.write("regex plugin: %s\n" % exc)
        items = [
            {
                "id": "error",
                "title": "Could not generate strings",
                "subtitle": str(exc),
                "payload": {"kind": "error"},
            }
        ]
    json.dump({"items": items}, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
