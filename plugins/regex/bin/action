#!/usr/bin/env python3

import json
import os
import subprocess
import sys


def _copy(text):
    dest = os.environ.get("SUMMON_REGEX_ACTION_OUT")
    if dest:
        parent = os.path.dirname(dest)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(dest, "w", encoding="utf-8") as fh:
            fh.write(text)
        return 0
    env = os.environ.copy()
    if not env.get("LANG") and not env.get("LC_ALL"):
        env["LC_ALL"] = "en_US.UTF-8"
    proc = subprocess.run(
        ["/usr/bin/pbcopy"],
        input=text.encode("utf-8"),
        env=env,
    )
    return proc.returncode


def main():
    try:
        data = json.load(sys.stdin)
    except Exception as exc:
        sys.stderr.write("regex plugin: invalid action JSON: %s\n" % exc)
        sys.exit(1)
    if not isinstance(data, dict):
        sys.stderr.write("regex plugin: action JSON must be an object\n")
        sys.exit(1)
    payload = data.get("payload") or {}
    if not isinstance(payload, dict):
        sys.exit(0)
    if payload.get("kind") != "text":
        sys.exit(0)
    text = payload.get("text")
    if not isinstance(text, str):
        sys.stderr.write("regex plugin: missing payload.text\n")
        sys.exit(1)
    sys.exit(_copy(text))


if __name__ == "__main__":
    main()
