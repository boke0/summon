ObjC.import("Foundation");

function stdinText() {
	const data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
	const str = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding);
	if (str === null) {
		return "";
	}
	return ObjC.unwrap(str);
}

function run() {
	const raw = stdinText().replace(/^\s+|\s+$/g, "");
	if (!raw) {
		throw new Error("empty");
	}
	const candidate = JSON.parse(raw);
	const payload = candidate.payload || {};
	let kind = typeof payload.kind === "string" ? payload.kind : "app";
	const path =
		typeof payload.path === "string" && payload.path
			? payload.path
			: typeof candidate.icon === "string"
				? candidate.icon
				: "";
	if (kind === "app") {
		if (!path) {
			throw new Error("missing path");
		}
		return "app\t" + path;
	}
	if (kind === "window") {
		const pid = payload.pid != null ? String(payload.pid) : "";
		const title = typeof payload.windowTitle === "string" ? payload.windowTitle : "";
		const index = payload.windowIndex != null ? String(payload.windowIndex) : "";
		return ["window", path, pid, title, index].join("\t");
	}
	throw new Error("unknown kind " + kind);
}
