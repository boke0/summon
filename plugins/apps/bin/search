#!/bin/bash
set -euo pipefail

QUERY="${1-}"

# Sets ESCAPED instead of printing, so callers avoid a $(...) subshell per field.
json_escape() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/\\n}
	s=${s//$'\r'/\\r}
	s=${s//$'\t'/\\t}
	ESCAPED=$s
}

list_roots() {
	if [[ -n "${SUMMON_APPS_ROOTS:-}" ]]; then
		printf '%s\n' "$SUMMON_APPS_ROOTS" | /usr/bin/tr ':' '\n'
		return
	fi
	printf '%s\n' "/Applications"
	printf '%s\n' "/System/Applications"
	printf '%s\n' "$HOME/Applications"
}

# Deep enough for <root>/Unity/Hub/Editor/<ver>/Unity.app, shallow enough to
# skip huge non-bundle trees (Unity PlaybackEngines, SDKs) that took ~10s to walk.
MAX_DEPTH=5

# name<TAB>path — one find pass, no defaults / osascript per app.
scan_apps() {
	local root app resolved name
	while IFS= read -r root; do
		[[ -z "$root" || ! -d "$root" ]] && continue
		while IFS= read -r app; do
			[[ -z "$app" ]] && continue
			resolved=$(CDPATH= cd -- "$app" && pwd)
			# Parameter expansion, not basename: exec is costly per app on some Macs.
			name=${resolved##*/}
			name=${name%.app}
			printf '%s\t%s\n' "$name" "$resolved"
		done < <(/usr/bin/find "$root" -maxdepth "$MAX_DEPTH" -type d -name '*.app' -print -prune 2>/dev/null)
	done < <(list_roots)
}

app_item() {
	local name path
	json_escape "$1"; name=$ESCAPED
	json_escape "$2"; path=$ESCAPED
	printf '{"icon":"%s","id":"app:%s","payload":{"kind":"app","path":"%s"},"subtitle":"%s","title":"%s"}' \
		"$path" "$path" "$path" "$path" "$name"
}

grep_escape() {
	printf '%s' "$1" | /usr/bin/sed 's/[.^$*+?(){}|[\\]/\\&/g'
}

scanned=$(mktemp)
matched=$(mktemp)
trap 'rm -f "$scanned" "$matched"' EXIT
scan_apps |
	LC_ALL=C /usr/bin/sort -t $'\t' -k2,2 -u |
	LC_ALL=C /usr/bin/sort -t $'\t' -k1,1 > "$scanned"

if [[ -z "$QUERY" ]]; then
	/bin/cp "$scanned" "$matched"
else
	/usr/bin/grep -i "^$(grep_escape "$QUERY")" "$scanned" > "$matched" || true
fi

printf '{"items":['
first=1
while IFS=$'\t' read -r name path; do
	[[ -z "$name" || -z "$path" ]] && continue
	if ((first)); then
		first=0
	else
		printf ','
	fi
	app_item "$name" "$path"
done < "$matched"
printf ']}\n'
