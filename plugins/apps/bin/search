#!/bin/bash
set -euo pipefail

QUERY="${1-}"

json_escape() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/\\n}
	s=${s//$'\r'/\\r}
	s=${s//$'\t'/\\t}
	printf '%s' "$s"
}

list_roots() {
	if [[ -n "${SUMMON_APPS_ROOTS:-}" ]]; then
		printf '%s\n' "$SUMMON_APPS_ROOTS" | /usr/bin/tr ':' '\n'
		return
	fi
	printf '%s\n' "/Applications"
	printf '%s\n' "/System/Applications"
	printf '%s\n' "$HOME/Applications"
}

# name<TAB>path — one find pass, no defaults / osascript per app.
scan_apps() {
	local root app resolved name
	while IFS= read -r root; do
		[[ -z "$root" || ! -d "$root" ]] && continue
		while IFS= read -r app; do
			[[ -z "$app" ]] && continue
			resolved=$(CDPATH= cd -- "$app" && pwd)
			name=$(basename "$resolved" .app)
			printf '%s\t%s\n' "$name" "$resolved"
		done < <(/usr/bin/find "$root" -name '*.app' -type d -print -prune 2>/dev/null)
	done < <(list_roots)
}

app_item() {
	local name=$1 path=$2
	printf '{"icon":"%s","id":"app:%s","payload":{"kind":"app","path":"%s"},"subtitle":"%s","title":"%s"}' \
		"$(json_escape "$path")" \
		"$(json_escape "$path")" \
		"$(json_escape "$path")" \
		"$(json_escape "$path")" \
		"$(json_escape "$name")"
}

grep_escape() {
	printf '%s' "$1" | /usr/bin/sed 's/[.^$*+?(){}|[\\]/\\&/g'
}

scanned=$(mktemp)
matched=$(mktemp)
trap 'rm -f "$scanned" "$matched"' EXIT
scan_apps |
	LC_ALL=C /usr/bin/sort -t $'\t' -k2,2 -u |
	LC_ALL=C /usr/bin/sort -t $'\t' -k1,1 > "$scanned"

if [[ -z "$QUERY" ]]; then
	/bin/cp "$scanned" "$matched"
else
	/usr/bin/grep -i "^$(grep_escape "$QUERY")" "$scanned" > "$matched" || true
fi

printf '{"items":['
first=1
while IFS=$'\t' read -r name path; do
	[[ -z "$name" || -z "$path" ]] && continue
	if ((first)); then
		first=0
	else
		printf ','
	fi
	printf '%s' "$(app_item "$name" "$path")"
done < "$matched"
printf ']}\n'
