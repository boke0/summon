#!/bin/bash
set -euo pipefail

here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)
# shellcheck source=../lib/constants.sh
source "$root/lib/constants.sh"
match="$root/lib/match.sh"

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v jq >/dev/null 2>&1; then
	printf '%s\n' "jq is required. Install it with: brew install jq" >&2
	exit 1
fi

json=$(cat)
kind_path=$(printf '%s' "$json" | jq -er '
	(.payload.kind // (if .id == "agents" then "agents" else "" end)) as $kind
	| if $kind == "agents" then "agents\t"
	elif $kind == "workspace" then
		(.payload.path // "") as $p
		| if $p == "" then error("missing path") else "workspace\t\($p)" end
	elif $kind == "" then error("missing kind")
	else error("unknown kind \($kind)") end
')
kind="${kind_path%%$'\t'*}"
path="${kind_path#*$'\t'}"

applescript_quote() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	printf '%s' "$s"
}

click_cursor_menu() {
	local menu=$1 item=$2
	local qmenu qitem
	qmenu=$(applescript_quote "$menu")
	qitem=$(applescript_quote "$item")
	/usr/bin/osascript -e \
		"tell application \"System Events\" to tell application process \"Cursor\" to click menu item \"${qitem}\" of menu \"${qmenu}\" of menu bar 1" \
		>/dev/null 2>&1
}

cursor_window_titles() {
	/usr/bin/osascript <<'APPLESCRIPT'
tell application "System Events"
	tell application process "Cursor"
		set xs to {}
		repeat with w in windows
			set end of xs to name of w
		end repeat
		set AppleScript's text item delimiters to linefeed
		return xs as text
	end tell
end tell
APPLESCRIPT
}

# AXRaise only changes z-order. Cursor's Electron windows stay unfocused
# (AXFocusedUIElement is missing) until the content group is clicked.
focus_cursor_window() {
	local title=$1
	local qtitle
	qtitle=$(applescript_quote "$title")
	/usr/bin/osascript >/dev/null 2>&1 <<APPLESCRIPT
tell application "System Events"
	tell application process "Cursor"
		set frontmost to true
		set target to missing value
		if "${qtitle}" is "" then
			try
				set target to first window whose value of attribute "AXMain" is true
			end try
		else
			try
				set target to window "${qtitle}"
			end try
		end if
		if target is missing value then error "no window"
		tell target
			perform action "AXRaise"
			try
				set value of attribute "AXMain" to true
			end try
			try
				click group 1
			end try
		end tell
	end tell
end tell
APPLESCRIPT
}

focus_existing_agents_window() {
	local titles title
	titles=$(cursor_window_titles) || return 1
	while IFS= read -r title; do
		[[ -z "$title" ]] && continue
		if /bin/bash "$match" is-agents "$title"; then
			focus_cursor_window "$title"
			return 0
		fi
	done <<< "$titles"
	return 1
}

open_workspace() {
	[[ -d "$path" ]] || {
		printf '%s\n' "Workspace folder was not found: $path" >&2
		exit 1
	}
	[[ -x "$CURSOR_CLI" ]] || {
		printf '%s\n' "Cursor was not found at $CURSOR_APP." >&2
		exit 1
	}
	# --classic opens the folder in the classic IDE, or brings that IDE
	# window to the front if it is already open. Do not match other
	# windows by folder-name substring: Cursor 3 Agents chats share
	# that title pattern.
	"$CURSOR_CLI" --classic "$path" >/dev/null 2>&1 || {
		printf '%s\n' "Could not open workspace in Cursor." >&2
		exit 1
	}
	# --classic makes the IDE window main but does not give it key focus.
	local attempt
	for attempt in $(/usr/bin/seq 1 5); do
		if focus_cursor_window ""; then
			return 0
		fi
		if [[ "$attempt" -lt 5 ]]; then
			sleep "$CURSOR_MENU_INTERVAL"
		fi
	done
}

open_agents() {
	[[ -d "$CURSOR_APP" ]] || {
		printf '%s\n' "Cursor was not found at $CURSOR_APP." >&2
		exit 1
	}
	/usr/bin/open -b "$CURSOR_BUNDLE_ID" >/dev/null 2>&1 || true
	local attempt pair menu item
	for attempt in $(/usr/bin/seq 1 "$CURSOR_MENU_RETRY"); do
		if focus_existing_agents_window; then
			return 0
		fi
		/usr/bin/osascript >/dev/null 2>&1 \
			-e 'tell application "System Events" to tell application process "Cursor" to set frontmost to true' \
			|| true
		for pair in "${CURSOR_AGENTS_MENUS[@]}"; do
			menu="${pair%%$'\t'*}"
			item="${pair#*$'\t'}"
			if click_cursor_menu "$menu" "$item"; then
				focus_existing_agents_window || focus_cursor_window ""
				return 0
			fi
		done
		if [[ "$attempt" -lt "$CURSOR_MENU_RETRY" ]]; then
			sleep "$CURSOR_MENU_INTERVAL"
		fi
	done
	printf '%s\n' "Could not find or open the Cursor Agents window. Cursor may still be starting, or Accessibility permission is missing." >&2
	exit 1
}

case "$kind" in
workspace)
	open_workspace
	;;
agents)
	open_agents
	;;
*)
	printf '%s\n' "unknown kind: $kind" >&2
	exit 1
	;;
esac
