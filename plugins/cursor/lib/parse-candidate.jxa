ObjC.import("Foundation");

function stdinText() {
	const data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
	const str = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding);
	if (str === null) {
		return "";
	}
	return ObjC.unwrap(str);
}

function run() {
	const raw = stdinText().replace(/^\s+|\s+$/g, "");
	if (!raw) {
		throw new Error("empty");
	}
	const candidate = JSON.parse(raw);
	let kind = "";
	if (candidate.payload && typeof candidate.payload.kind === "string") {
		kind = candidate.payload.kind;
	} else if (candidate.id === "agents") {
		kind = "agents";
	}
	if (!kind) {
		throw new Error("missing kind");
	}
	if (kind === "agents") {
		return "agents\t";
	}
	if (kind === "workspace") {
		const path =
			candidate.payload && typeof candidate.payload.path === "string"
				? candidate.payload.path
				: "";
		if (!path) {
			throw new Error("missing path");
		}
		return "workspace\t" + path;
	}
	throw new Error("unknown kind " + kind);
}
